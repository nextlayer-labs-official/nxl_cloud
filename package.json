{
  "name": "nextlayer-cloud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@nextlayer/web",
    "dev:api": "npm run dev --workspace=@nextlayer/api",
    "build:web": "npm run build --workspace=@nextlayer/web",
    "build:api": "npm run build --workspace=@nextlayer/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "npm run generate --workspace=@nextlayer/database && npm run build --workspace=@nextlayer/database",
    "db:generate": "npm run generate --workspace=@nextlayer/database && npm run build --workspace=@nextlayer/database",
    "db:migrate": "npm run migrate --workspace=@nextlayer/database",
    "db:seed": "npm run seed --workspace=@nextlayer/database",
    "db:studio": "npm run studio --workspace=@nextlayer/database"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
