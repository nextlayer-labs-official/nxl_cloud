# Copy to .env and fill in your local MySQL connection details.
DATABASE_URL="mysql://root@127.0.0.1:3306/nextlayer_cloud_dev"

# apps/api CORS — must match the origin apps/web is served from.
WEB_ORIGIN="http://localhost:3000"

# Wasabi (S3-compatible object storage) — get these from your Wasabi console.
# Without real values, apps/api still boots and file metadata endpoints work,
# but presigned upload/download URLs won't resolve to a real bucket.
#
# The portal uploads directly from the browser to Wasabi via presigned URLs, so
# the bucket also needs a CORS policy allowing PUT from WEB_ORIGIN — without it,
# uploads fail at the browser's CORS preflight before even reaching Wasabi. In
# the Wasabi console: bucket → Settings → CORS, allow method PUT, origin
# matching WEB_ORIGIN (and your production web origin once deployed), headers "*".
WASABI_ACCESS_KEY_ID=""
WASABI_SECRET_ACCESS_KEY=""
WASABI_BUCKET=""
WASABI_ENDPOINT="https://s3.wasabisys.com"
WASABI_REGION="us-east-1"
