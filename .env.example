# Copy to .env and fill in your local MySQL connection details.
DATABASE_URL="mysql://root@127.0.0.1:3306/nextlayer_cloud_dev"

# apps/api CORS — must match the origin apps/web is served from.
WEB_ORIGIN="http://localhost:3000"

# Wasabi (S3-compatible object storage) — get these from your Wasabi console.
# Without real values, apps/api still boots and file metadata endpoints work,
# but presigned upload/download URLs won't resolve to a real bucket.
#
# WASABI_ENDPOINT must match WASABI_REGION exactly — Wasabi requires a
# region-specific endpoint (s3.<region>.wasabisys.com). The generic
# s3.wasabisys.com only works for us-east-1; using it for any other region
# causes auth failures even with correct keys.
#
# If the API key belongs to a Wasabi sub-user (not the account owner), that
# sub-user has zero bucket access by default. Grant it explicitly via Wasabi
# Console -> Users -> the sub-user -> Policies. (Don't use the bucket's own
# ACL/"Quick Settings" for this — that controls public access, not per-user
# permissions, and making the bucket public is not the fix.)
#
# If uploads still fail after credentials/permissions are correct, the bucket's
# CORS policy is the next thing to check, since the portal uploads directly
# from the browser via a presigned URL (bucket -> Settings -> CORS, allow
# method PUT, origin matching WEB_ORIGIN, headers "*").
WASABI_ACCESS_KEY_ID=""
WASABI_SECRET_ACCESS_KEY=""
WASABI_BUCKET=""
WASABI_ENDPOINT="https://s3.us-east-1.wasabisys.com"
WASABI_REGION="us-east-1"
