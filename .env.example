# Copy to .env and fill in your local MySQL connection details.
DATABASE_URL="mysql://root@127.0.0.1:3306/nextlayer_cloud_dev"

# apps/api CORS — must match the origin apps/web is served from.
WEB_ORIGIN="http://localhost:3000"

# Zata (S3-compatible object storage) — the platform's primary/default
# storage provider, provider id "zata". Without real values, apps/api still
# boots and file metadata endpoints work, but presigned upload/download URLs
# won't resolve to a real bucket.
#
# ZATA_ENDPOINT must match ZATA_REGION exactly — a region-specific endpoint
# is required; using the wrong one for a given region causes auth failures
# even with correct keys.
#
# If the API key belongs to a sub-user (not the account owner), that
# sub-user has zero bucket access by default. Grant it explicitly via the
# provider's console -> Users -> the sub-user -> Policies. (Don't use the
# bucket's own ACL/"Quick Settings" for this — that controls public access,
# not per-user permissions, and making the bucket public is not the fix.)
#
# If uploads still fail after credentials/permissions are correct, the bucket's
# CORS policy is the next thing to check, since the portal uploads directly
# from the browser via a presigned URL (bucket -> Settings -> CORS, allow
# method PUT, origin matching WEB_ORIGIN, headers "*").
ZATA_ACCESS_KEY_ID=""
ZATA_SECRET_ACCESS_KEY=""
ZATA_BUCKET=""
ZATA_ENDPOINT=""
ZATA_REGION=""

# Optional second storage provider — an actual Wasabi bucket, provider id
# "wasabi". Every File/FileVersion records which provider it actually lives
# in, so switching which one NEW uploads go to never breaks downloads of
# files already sitting in the other one. Leave WASABI_BUCKET unset to not
# configure a second provider at all (the default, same as before this
# existed) — apps/api still needs a restart to pick up these vars (like
# ZATA_*), since that's what makes the second provider's client exist at
# all.
#
# Once both are configured, which one is the DEFAULT (where new uploads go)
# is a live admin-panel setting (Admin -> Settings -> "Default storage
# provider") — that switch takes effect immediately, no restart. Nothing to
# set here for that; it's a database setting, not an env var.
# WASABI_ACCESS_KEY_ID=""
# WASABI_SECRET_ACCESS_KEY=""
# WASABI_BUCKET=""
# WASABI_ENDPOINT=""
# WASABI_REGION=""

# Razorpay (billing) — get these from your Razorpay dashboard (test mode keys
# are fine for development). Without real keys, apps/api still boots and
# GET /billing/plans works, but order/verify/webhook endpoints return a clear
# 503 instead of crashing.
#
# One-time charge per billing period (Orders API), not the Subscriptions API —
# renewal/expiry is tracked in our own Subscription.currentPeriodEnd, editable
# from the admin panel, rather than Razorpay auto-billing the customer.
#
# RAZORPAY_WEBHOOK_SECRET comes from the webhook you register in the Razorpay
# dashboard (Settings -> Webhooks) pointed at
# https://<your-api-host>/billing/webhook, subscribed to at least
# payment.captured and payment.failed.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMTP (email verification + password reset) — any mailbox/provider's SMTP
# credentials work here (Gmail app password, Mailtrap, your own mail server,
# etc.). Without real values, apps/api still boots and registration/password
# reset still work — the email is just skipped with a logged warning instead
# of actually being sent, so you can test the token flow via the API/DB
# directly without a real inbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Skylyer <no-reply@skylyer.cloud>"
