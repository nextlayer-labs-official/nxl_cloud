// Nextlayer Cloud — core data model.
// Entities trace directly to what the marketing site promises: multi-tenant orgs,
// team spaces, granular folder/file permissions, unlimited version history,
// expiring share links, audit/activity logging, SSO/SCIM, and plan-based billing.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccessLevel {
  VIEWER
  EDITOR
  ADMIN
}

enum ResourceType {
  FILE
  FOLDER
}

enum GranteeType {
  USER
  TEAM
  ORGANIZATION
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        Membership[]
  teamMemberships    TeamMembership[]
  sessions           Session[]
  uploadedFiles      File[]           @relation("FileUploadedBy")
  fileVersions       FileVersion[]
  createdFolders     Folder[]
  permissionsGranted Permission[]     @relation("PermissionGrantedBy")
  shareLinksCreated  ShareLink[]
  comments           Comment[]
  auditLogs          AuditLog[]
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  region      String?
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships   Membership[]
  teams         Team[]
  folders       Folder[]
  files         File[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  payments      Payment[]
  ssoConnection SsoConnection?
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  TeamMembership[]
  folders      Folder[]

  @@index([organizationId])
}

model TeamMembership {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Folder {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String?
  parentId       String?
  name           String
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent       Folder?      @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]     @relation("FolderChildren")
  createdBy    User         @relation(fields: [createdById], references: [id])
  files        File[]

  @@index([organizationId])
  @@index([parentId])
  @@index([teamId])
}

model File {
  id             String    @id @default(cuid())
  organizationId String
  folderId       String?
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  uploadedById   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy   User          @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  versions     FileVersion[]
  comments     Comment[]

  @@index([organizationId])
  @@index([folderId])
}

model FileVersion {
  id            String   @id @default(cuid())
  fileId        String
  versionNumber Int
  storageKey    String
  sizeBytes     Int
  createdById   String
  createdAt     DateTime @default(now())

  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([fileId, versionNumber])
}

/// Granular, resource-level access control ("down to the folder"). A null
/// granteeId with granteeType ORGANIZATION means an org-wide default grant.
model Permission {
  id           String       @id @default(cuid())
  resourceType ResourceType
  resourceId   String
  granteeType  GranteeType
  granteeId    String?
  accessLevel  AccessLevel
  createdById  String
  createdAt    DateTime     @default(now())

  createdBy User @relation("PermissionGrantedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@index([granteeType, granteeId])
}

/// Expiring, revocable, optionally password-protected external links.
model ShareLink {
  id            String       @id @default(cuid())
  resourceType  ResourceType
  resourceId    String
  token         String       @unique
  passwordHash  String?
  allowDownload Boolean      @default(true)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime     @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
}

model Comment {
  id              String   @id @default(cuid())
  fileId          String
  authorId        String
  body            String   @db.Text
  parentCommentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id])
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([fileId])
}

/// Single event log serving both the audit trail and the activity feed —
/// one source of truth instead of two overlapping tables. The portal UI
/// queries/filters this differently depending on which view it's rendering.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Platform staff, deliberately decoupled from `User`/`Session` — admin identity
/// never shares a table, session cookie, or login form with customer accounts.
/// Lives in its own `admin` module/folder on both apps so it can be lifted into
/// a fully separate `apps/admin`/`apps/admin-api` later with minimal rework.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  sessions AdminSession[]
}

model AdminSession {
  id           String   @id @default(cuid())
  adminUserId  String
  sessionToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// Mirrors the 3 Pricing page tiers (Starter/Business/Enterprise).
model Plan {
  id                String   @id @default(cuid())
  name              String   @unique
  priceMonthlyCents Int?
  priceYearlyCents  Int?
  storageLimitGb    Int?
  seatLimit         Int?
  features          Json
  /// The plan new signups trial by default. Admin-set — deliberately not
  /// matched by `name` (e.g. "Business"), since plan names are renameable
  /// from the admin panel and a name-based lookup silently breaks signups
  /// the moment the plan is renamed. At most one Plan should have this true;
  /// enforced in AdminService, not a DB constraint.
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions        Subscription[]
  payments             Payment[]
  pendingSubscriptions Subscription[] @relation("PendingPlan")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  billingCycle         BillingCycle       @default(MONTHLY)
  currentPeriodEnd     DateTime?
  /// Last Razorpay order created for this org's checkout (one-time charge per
  /// billing period — see Phase 7 in docs/roadmap.md for why not Subscriptions).
  razorpayOrderId      String?
  razorpayPaymentId    String?
  /// Admin-set discount off the plan's list price (0-100). Enforced by this
  /// app's own price display, not a payment-gateway coupon.
  discountPercent      Int?
  /// Admin-set "comped" date — while in the future, the customer is treated
  /// as fully paid regardless of `status`/billing, independent of `discountPercent`.
  freeUntil            DateTime?
  /// Admin-set per-org storage cap in GB, overriding the plan's default
  /// (`Plan.storageLimitGb`). Null = inherit the plan's limit.
  storageLimitGbOverride Int?
  /// A requested downgrade, applied automatically once `currentPeriodEnd`
  /// passes (see subscription-lifecycle.util.ts) rather than immediately —
  /// the customer keeps what they already paid for until then. Upgrades never
  /// use this; they're charged and switched immediately.
  pendingPlanId        String?
  pendingBillingCycle  BillingCycle?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("PendingPlan", fields: [pendingPlanId], references: [id])
}

/// One row per successfully-captured payment — the transaction history shown
/// on /portal/settings. Separate from Subscription (which only tracks current
/// state) since a subscription's history spans multiple payments over time.
model Payment {
  id                String       @id @default(cuid())
  organizationId    String
  planId            String
  amountCents       Int
  currency          String       @default("INR")
  billingCycle      BillingCycle
  razorpayOrderId   String
  razorpayPaymentId String       @unique
  createdAt         DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
}

/// Lean, generic config rather than fully-specified SAML fields — Phase 4
/// (Authentication) will refine this once the actual IdP integration is built.
model SsoConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique
  provider       String
  config         Json
  scimEnabled    Boolean  @default(false)
  scimToken      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
