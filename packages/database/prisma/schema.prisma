// Nextlayer Cloud — core data model.
// Entities trace directly to what the marketing site promises: multi-tenant orgs,
// team spaces, granular folder/file permissions, unlimited version history,
// expiring share links, audit/activity logging, SSO/SCIM, and plan-based billing.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccessLevel {
  VIEWER
  EDITOR
  ADMIN
}

enum ResourceType {
  FILE
  FOLDER
}

enum GranteeType {
  USER
  TEAM
  ORGANIZATION
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PartnerChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccessRequestStatus {
  PENDING
  GRANTED
  DENIED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships            Membership[]
  teamMemberships        TeamMembership[]
  sessions               Session[]
  uploadedFiles          File[]              @relation("FileUploadedBy")
  fileVersions           FileVersion[]
  createdFolders         Folder[]
  permissionsGranted     Permission[]        @relation("PermissionGrantedBy")
  shareLinksCreated      ShareLink[]
  comments               Comment[]
  auditLogs              AuditLog[]
  stars                  Star[]
  verificationTokens     VerificationToken[]
  accessRequestsMade     AccessRequest[]     @relation("AccessRequestedBy")
  accessRequestsResolved AccessRequest[]     @relation("AccessRequestResolvedBy")
}

/// One table for both email-verification and password-reset links — same
/// "one source of truth" reasoning as AuditLog, rather than two near-identical
/// token models.
model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  token     String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  region      String?
  suspendedAt DateTime?
  /// Set once the org owner maps in a partner's code (Settings) — that first
  /// mapping applies immediately since no existing partner relationship is
  /// being disturbed. While set, self-serve billing (BillingService.createOrder)
  /// is locked — only that partner (via the partner portal) or platform admin
  /// can change the plan. Leaving or switching away from an existing mapping is
  /// NOT immediate — see PartnerChangeRequest.
  partnerId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships          Membership[]
  teams                Team[]
  folders              Folder[]
  files                File[]
  auditLogs            AuditLog[]
  subscription         Subscription?
  payments             Payment[]
  ssoConnection        SsoConnection?
  stars                Star[]
  partner              Partner?                   @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerChangeRequest PartnerChangeRequest?
  partnerWalletDebits  PartnerWalletTransaction[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  TeamMembership[]
  folders      Folder[]

  @@index([organizationId])
}

model TeamMembership {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Folder {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String?
  parentId       String?
  name           String
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Soft delete, mirroring File.deletedAt — deleting a folder trashes it and
  /// cascades the same deletedAt to every descendant folder/file, so the whole
  /// subtree can be restored (or permanently purged) as one unit.
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent       Folder?      @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]     @relation("FolderChildren")
  createdBy    User         @relation(fields: [createdById], references: [id])
  files        File[]

  @@index([organizationId])
  @@index([parentId])
  @@index([teamId])
}

model File {
  id             String    @id @default(cuid())
  organizationId String
  folderId       String?
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  uploadedById   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy   User          @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  versions     FileVersion[]
  comments     Comment[]

  @@index([organizationId])
  @@index([folderId])
}

model FileVersion {
  id            String   @id @default(cuid())
  fileId        String
  versionNumber Int
  storageKey    String
  sizeBytes     Int
  createdById   String
  createdAt     DateTime @default(now())

  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([fileId, versionNumber])
}

/// Granular, resource-level access control ("down to the folder"). A null
/// granteeId with granteeType ORGANIZATION means an org-wide default grant.
/// A row can also be "pending" — shared to an email with no Nextlayer Cloud
/// account yet (granteeId null, pendingEmail set). It grants nothing until
/// claimed: registering with a matching email adopts every pending row as
/// that user's real grant (see claimPendingGrants in permission.util.ts),
/// mirroring Dropbox/Drive's "invite someone who hasn't signed up yet" flow.
model Permission {
  id           String       @id @default(cuid())
  resourceType ResourceType
  resourceId   String
  granteeType  GranteeType
  granteeId    String?
  pendingEmail String?
  accessLevel  AccessLevel
  createdById  String
  createdAt    DateTime     @default(now())

  createdBy User @relation("PermissionGrantedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, granteeType, granteeId])
  @@unique([resourceType, resourceId, pendingEmail])
  @@index([resourceType, resourceId])
  @@index([granteeType, granteeId])
  @@index([pendingEmail])
}

/// A "request access" from someone who hit a file/folder they don't have
/// permission for (mirrors Drive's request-access flow). The resource's
/// owner resolves it — GRANTED goes through the same grantPermission() path
/// as a normal share, DENIED is just a dismissal. Re-requesting after a
/// DENIED (or GRANTED, e.g. access was later revoked) resets it to PENDING
/// rather than creating a duplicate row.
model AccessRequest {
  id            String              @id @default(cuid())
  resourceType  ResourceType
  resourceId    String
  requestedById String
  message       String?
  status        AccessRequestStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())

  requestedBy User  @relation("AccessRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy  User? @relation("AccessRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([resourceType, resourceId, requestedById])
  @@index([resourceType, resourceId])
}

/// Expiring, revocable, optionally password-protected external links.
model ShareLink {
  id            String       @id @default(cuid())
  resourceType  ResourceType
  resourceId    String
  token         String       @unique
  passwordHash  String?
  allowDownload Boolean      @default(true)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime     @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
}

model Comment {
  id              String   @id @default(cuid())
  fileId          String
  authorId        String
  body            String   @db.Text
  parentCommentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id])
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([fileId])
}

/// Single event log serving both the audit trail and the activity feed —
/// one source of truth instead of two overlapping tables. The portal UI
/// queries/filters this differently depending on which view it's rendering.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

/// Per-user favorites — starring is personal, not shared across an org (unlike
/// ShareLink/Permission, which are org-visible), so it's keyed by userId too.
model Star {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  resourceType   ResourceType
  resourceId     String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([organizationId, userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Platform staff, deliberately decoupled from `User`/`Session` — admin identity
/// never shares a table, session cookie, or login form with customer accounts.
/// Lives in its own `admin` module/folder on both apps so it can be lifted into
/// a fully separate `apps/admin`/`apps/admin-api` later with minimal rework.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  sessions             AdminSession[]
  partnerWalletCredits PartnerWalletTransaction[]
}

model AdminSession {
  id           String   @id @default(cuid())
  adminUserId  String
  sessionToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// A reseller/channel partner (Zoho-style) — has its own login (own portal,
/// own session, deliberately decoupled from both customer Users and platform
/// AdminUsers, same reasoning as AdminUser's own doc comment) and a unique
/// `code` customers enter in Settings to map their org to them. Once mapped,
/// only this partner (via their portal) or a platform admin can change that
/// org's plan — the org's own self-serve checkout is locked.
model Partner {
  id                 String    @id @default(cuid())
  name               String
  code               String    @unique
  email              String    @unique
  passwordHash       String
  suspendedAt        DateTime?
  /// Prepaid balance, manually topped up by admin (PartnerWalletTransaction
  /// CREDIT rows) against payment collected outside the platform (bank
  /// transfer, cheque, etc.) — no payment gateway involved. Activating a
  /// customer's first plan or changing an already-active one debits this,
  /// same upgrade/downgrade proration rule as BillingService's customer
  /// checkout (see PartnerService for the mirrored logic). Never goes
  /// negative — every debit is guarded against the balance at write time.
  walletBalanceCents Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           PartnerSession[]
  organizations      Organization[]
  /// Requests to leave/switch away FROM this partner — this partner is the one who must approve.
  releaseRequests    PartnerChangeRequest[]     @relation("PartnerChangeRequestCurrent")
  /// Requests to switch TO this partner (initiated by a customer already mapped elsewhere).
  incomingRequests   PartnerChangeRequest[]     @relation("PartnerChangeRequestNew")
  /// Admin-negotiated per-plan pricing for this partner — see PartnerPlanPrice.
  planPrices         PartnerPlanPrice[]
  walletTransactions PartnerWalletTransaction[]
}

enum PartnerWalletTransactionType {
  CREDIT
  DEBIT
}

/// One row per wallet movement — a manual admin top-up (CREDIT, `createdBy` +
/// `note` carry the "transaction details": who added it and why, e.g. a bank
/// reference) or an automatic debit when a partner activates/changes a
/// customer's plan (DEBIT, `organization` + `plan` say what it was for).
/// `balanceAfterCents` snapshots the running balance right after this row, so
/// history renders without re-summing every prior row.
model PartnerWalletTransaction {
  id                String                       @id @default(cuid())
  partnerId         String
  type              PartnerWalletTransactionType
  amountCents       Int
  balanceAfterCents Int
  note              String?
  createdById       String?
  organizationId    String?
  planId            String?
  createdAt         DateTime                     @default(now())

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy    AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
}

/// Admin-set, per-(partner, plan) negotiated pricing — distinct from Plan's own
/// customer-facing price. Read by PartnerService when resolving what a plan
/// change actually debits from the partner's wallet; purely informational
/// beyond that. A plan with no row here for a given partner has no special
/// pricing set yet, and falls back to the plan's own list price.
model PartnerPlanPrice {
  id                String   @id @default(cuid())
  partnerId         String
  planId            String
  priceMonthlyCents Int?
  priceYearlyCents  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([partnerId, planId])
}

/// A customer's request to leave (or switch away from) their CURRENT partner
/// mapping. Unlike applying a code for the first time (Organization.partnerId's
/// comment — that's immediate), releasing or changing an existing mapping needs
/// the current partner's sign-off before it takes effect, since the partner has
/// a commercial relationship at stake. `newPartnerId` is null for a plain
/// removal request, set when the customer asked to switch straight to a
/// different partner's code. One row per org (like AccessRequest's per-requester
/// row) — re-requesting after a resolved request resets it back to PENDING.
model PartnerChangeRequest {
  id               String                     @id @default(cuid())
  organizationId   String                     @unique
  currentPartnerId String
  newPartnerId     String?
  status           PartnerChangeRequestStatus @default(PENDING)
  resolvedAt       DateTime?
  createdAt        DateTime                   @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentPartner Partner      @relation("PartnerChangeRequestCurrent", fields: [currentPartnerId], references: [id], onDelete: Cascade)
  newPartner     Partner?     @relation("PartnerChangeRequestNew", fields: [newPartnerId], references: [id], onDelete: Cascade)

  @@index([currentPartnerId, status])
}

model PartnerSession {
  id           String   @id @default(cuid())
  partnerId    String
  sessionToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

/// Mirrors the 3 Pricing page tiers (Starter/Business/Enterprise).
model Plan {
  id                String   @id @default(cuid())
  name              String   @unique
  priceMonthlyCents Int?
  priceYearlyCents  Int?
  storageLimitGb    Int?
  features          Json
  /// The plan new signups trial by default. Admin-set — deliberately not
  /// matched by `name` (e.g. "Business"), since plan names are renameable
  /// from the admin panel and a name-based lookup silently breaks signups
  /// the moment the plan is renamed. At most one Plan should have this true;
  /// enforced in AdminService, not a DB constraint.
  isDefault         Boolean  @default(false)
  /// Whether new subscriptions to this plan start as TRIALING (for
  /// `trialDays`) or go straight to ACTIVE. A plan with this off and price
  /// fields at 0 is effectively an ongoing free tier; with it on, it's a
  /// time-boxed preview (regardless of the plan's price) — same mechanism,
  /// used either way. See AuthService.register / AdminService.createCustomer
  /// for where this is read.
  trialEnabled      Boolean  @default(true)
  /// Trial length in days, only used while `trialEnabled` is true.
  trialDays         Int      @default(14)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions       Subscription[]
  payments            Payment[]
  partnerPrices       PartnerPlanPrice[]
  partnerWalletDebits PartnerWalletTransaction[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodEnd       DateTime?
  /// Last Razorpay order created for this org's checkout (one-time charge per
  /// billing period — see Phase 7 in docs/roadmap.md for why not Subscriptions).
  razorpayOrderId        String?
  razorpayPaymentId      String?
  /// Admin-set discount off the plan's list price (0-100). Enforced by this
  /// app's own price display, not a payment-gateway coupon.
  discountPercent        Int?
  /// Admin-set "comped" date — while in the future, the customer is treated
  /// as fully paid regardless of `status`/billing, independent of `discountPercent`.
  freeUntil              DateTime?
  /// Admin-set per-org storage cap in GB, overriding the plan's default
  /// (`Plan.storageLimitGb`). Null = inherit the plan's limit.
  storageLimitGbOverride Int?
  /// Prorated credit from a downgrade (or a partial admin grant), applied
  /// automatically to reduce the amount charged on the next upgrade/switch.
  /// Never paid out or refunded directly — see billing.service.ts's
  /// proration math for how it's produced and consumed.
  creditBalanceCents     Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

/// One row per successfully-captured payment — the transaction history shown
/// on /portal/settings. Separate from Subscription (which only tracks current
/// state) since a subscription's history spans multiple payments over time.
model Payment {
  id                String       @id @default(cuid())
  organizationId    String
  planId            String
  amountCents       Int
  currency          String       @default("INR")
  billingCycle      BillingCycle
  razorpayOrderId   String
  razorpayPaymentId String       @unique
  createdAt         DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
}

/// Lean, generic config rather than fully-specified SAML fields — Phase 4
/// (Authentication) will refine this once the actual IdP integration is built.
model SsoConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique
  provider       String
  config         Json
  scimEnabled    Boolean  @default(false)
  scimToken      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
